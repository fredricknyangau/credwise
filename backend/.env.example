# Environment variables for Credwise backend
# Copy to .env and fill in real values.
# NEVER commit .env to Git.

# Application
ENVIRONMENT=development
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Database
DATABASE_URL=postgresql+asyncpg://credwise:credwise@localhost:5432/credwise
POSTGRES_USER=credwise
POSTGRES_PASSWORD=credwise
POSTGRES_DB=credwise
DB_MIN_SIZE=5
DB_MAX_SIZE=20

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_64_char_hex_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
